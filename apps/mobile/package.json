{
  "name": "@openphysio/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "exclude": [
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "android:apk": "expo prebuild --platform android --no-install && cd android && .\\gradlew.bat assembleRelease -PreactNativeArchitectures=arm64-v8a --no-daemon"
  },
  "dependencies": {
    "@openphysio/catalog": "workspace:*",
    "@openphysio/core": "workspace:*",
    "@openphysio/integrations": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.23",
    "expo-build-properties": "^58.0.12",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-speech-recognition": "58.0.1",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-health-connect": "^4.1.3",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "typescript": "~6.0.3"
  }
}
