{
  "name": "@openphysio/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "exclude": ["react-native-gesture-handler", "react-native-reanimated", "react-native-worklets"]
    }
  },
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "android:apk": "expo prebuild --platform android --no-install && cd android && .\\gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@openphysio/core": "workspace:*",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
